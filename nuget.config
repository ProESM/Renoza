<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Очищаем источники, чтобы использовать только явно указанные -->
    <clear />
    <!-- Основной источник NuGet для всех стандартных пакетов -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- Внутренний GitLab источник для пакетов компании -->
    <add key="GFCPlatformGitLab" value="https://gitlab.goodsforecast.ru/api/v4/projects/98/packages/nuget/index.json" protocolVersion="3" />
  </packageSources>

  <!-- Маппинг пакетов: какие пакеты откуда загружать -->
  <packageSourceMapping>
    <!-- Все стандартные пакеты берём с nuget.org -->
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>

    <!-- Пакеты компании берём с GitLab (укажите здесь ваши внутренние пакеты) -->
    <!-- <packageSource key="GFCPlatformGitLab"> -->
      <!-- Пример: раскомментируйте и укажите паттерны ваших внутренних пакетов -->
      <!-- <package pattern="GoodsForecast.*" /> -->
      <!-- <package pattern="YourCompany.*" /> -->
    <!-- </packageSource> -->
  </packageSourceMapping>
</configuration>
