{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "MassTransit": "Debug"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [PID:{ProcessId} TID:{ThreadId}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/cash-receipt-broker-.log",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [PID:{ProcessId} TID:{ThreadId}] {SourceContext} {Message:lj}{NewLine}{Exception}",
          "retainedFileCountLimit": 30
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId", "WithProcessId" ]
  },
  "ConnectionStrings": {
    "Renoza": "Host=g4c-rta-dev.goodsforecast.ru;Port=5432;Database=Renoza.Dev;Username=svc_gfc;Password=Kdf)!XiNh>u*v7!h>q4"
  },
  "Redis": {
    "ConnectionString": "host.docker.internal:6379",
    "KeyPrefix": "renoza:",
    "ConnectTimeout": 5000,
    "SyncTimeout": 5000
  },
  "RateLimit": {
    "Enabled": true,
    "MaxRequestsPerWindow": 10,
    "WindowDurationSeconds": 60,
    "UseSlidingWindow": true,
    "WhitelistedIPs": []
  },
  "RabbitMq": {
    "Host": "host.docker.internal",
    "Port": 5672,
    "VirtualHost": "renoza",
    "Username": "guest",
    "Password": "guest"
  },
  "CashReceiptBrokerOptions": {
    "CashReceiptInputConsumerQueueName": "ToCashReceiptInputConsumer"
  }
}
